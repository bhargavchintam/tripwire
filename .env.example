# Tripwire environment (master plan §8). FROZEN keys. Copy to .env and fill in.
# .env is gitignored — never commit real keys.

# --- ClickHouse (local Docker by default; swap to Cloud for the demo) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_SECURE=0
CLICKHOUSE_DATABASE=tripwire
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=tripwire
CLICKHOUSE_RO_USER=tripwire_ro
CLICKHOUSE_RO_PASSWORD=tripwire_ro_pw

# --- Models (Sripadha) ---
AKASHML_API_KEY=
AKASHML_BASE_URL=https://api.akashml.com/v1
AKASHML_MODEL_SMALL=
AKASHML_MODEL_LARGE=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Checkpoint ---
CHECKPOINT_URL=http://localhost:8000
TRIPWIRE_TOKEN=change-me
PUBLIC=0
# stub = built-in rule-based check; real = import ai.quick_check.classify
HOLD_CHECK=stub
# Decoy secret values seeded into the fake env (comma-separated). Synthetic only.
TRIPWIRE_HONEYTOKENS=AKIA-TRIPWIRE-DECOY-7Q2,tw_live_decoy_9f31c0

# --- Guild (stretch) ---
GUILD_TRIGGER_URL=
GUILD_TRIGGER_KEY=
