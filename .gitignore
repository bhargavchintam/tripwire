# --- secrets & env ---
.env
.env.*
!.env.example

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.uv/
uv.lock.bak
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- node / web ---
node_modules/
web/dist/
web/.vite/
*.local

# --- runtime output (keep the dirs, ignore contents) ---
var/*
!var/.gitkeep
reports/*
!reports/.gitkeep

# --- data dumps / large local files (keep .sql sources) ---
data/*.csv
data/*.parquet
*.log

# --- os / editor ---
.DS_Store
.idea/
.vscode/
*.swp
